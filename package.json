{
  "name": "lyso-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "App Lý Số Trọn Bộ (Tử Vi, Bát Tự, Lục Hào, Bát Trạch, Nạp Âm, Tổng Hợp, La bàn) — React + Vite + Capacitor (Android)",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build && npx cap sync android",
    "android:debug": "npm run cap:sync && node scripts/gradle.mjs assembleDebug app/build/outputs/apk/debug/app-debug.apk",
    "android:release": "npm run cap:sync && node scripts/gradle.mjs bundleRelease app/build/outputs/bundle/release/app-release.aab"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "~8.0.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "~8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "~8.1.5",
    "@capacitor/haptics": "~8.0.0",
    "@capacitor/preferences": "~8.0.1",
    "@capacitor/share": "~8.0.3",
    "@fontsource/be-vietnam-pro": "~5.3.0",
    "@fontsource/noto-serif": "~5.3.0",
    "lottie-web": "^5.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
